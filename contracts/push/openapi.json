{
  "openapi": "3.1.0",
  "info": {
    "title": "Tronicare Push Api",
    "version": "0.1.0",
    "description": "Source-derived HTTP contract for the Python implementation. Includes operational endpoints hidden from runtime OpenAPI. Use the base URL of this process; no production host is embedded."
  },
  "x-service": "push",
  "x-process": "api",
  "x-source-files": [
    "services/push/src/tronicare_push/api.py",
    "services/push/src/tronicare_push/store.py",
    "services/push/src/tronicare_push/runtime.py",
    "services/push/src/tronicare_push/settings.py",
    "packages/foundation/src/tronicare_foundation/admin_authorization.py",
    "packages/foundation/src/tronicare_foundation/outbox_status.py"
  ],
  "paths": {
    "/_health/live": {
      "get": {
        "operationId": "push_api_get__health_live",
        "summary": "Process liveness",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Process is live.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/_health/ready": {
      "get": {
        "operationId": "push_api_get__health_ready",
        "summary": "Process readiness",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Required dependencies / worker are ready.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ready": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "ready"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Required dependencies / worker are not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ready": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "ready"
                  ]
                }
              }
            }
          }
        },
        "description": "This probe does not use application authentication."
      }
    },
    "/v1/pushadmin/info": {
      "get": {
        "operationId": "push_api_get_v1_pushadmin_info",
        "summary": "Read service information",
        "tags": [
          "API"
        ],
        "security": [
          {
            "Token": []
          }
        ],
        "responses": {
          "200": {
            "description": "Service metadata, or Status=false and Error='bad authentication'.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Responses must not be cached.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "503": {
            "description": "Required service unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Responses must not be cached.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated caller lacks current platform authority.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Responses must not be cached.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          }
        },
        "description": "Missing or invalid Token returns HTTP 200 with Status=false. Normal callers need a valid shared Redis Users session and fresh Users /v1/usersadmin/context authority with platform level 90 or above on every request; ordinary valid sessions receive 403. The optional configured PUSH_ADMIN_INTERNAL_TOKEN authenticates trusted internal callers without Redis or HTTP. Missing, malformed or unavailable authorization dependencies fail closed with 503 before queue reads. Successful responses always include Outboxes.delivery and Outboxes.results with Size and Latency_Seconds. Delivery includes pending/sending provider jobs; results includes completed jobs awaiting reply publication, including uncertain outcomes. Queue aggregates use one read-only repeatable-read PostgreSQL snapshot, a five-second statement limit, a one-second lock limit and a four-second snapshot timeout. Redis and Users authorization stages are independently bounded. All info responses use Cache-Control: no-store. Public metrics do not read the queues."
      }
    },
    "/v1/pushadmin/metrics": {
      "get": {
        "operationId": "push_api_get_v1_pushadmin_metrics",
        "summary": "Read Prometheus metrics",
        "tags": [
          "API"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Prometheus text exposition.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "No Token header is required by this handler."
      }
    },
    "/v1/pushadmin/test": {
      "get": {
        "operationId": "push_api_get_v1_pushadmin_test",
        "summary": "Test the API listener",
        "tags": [
          "API"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Listener test result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "const": "Test OK"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pushadmin/devices": {
      "put": {
        "operationId": "push_api_put_v1_pushadmin_devices",
        "summary": "Register a push device",
        "tags": [
          "API"
        ],
        "security": [
          {
            "Token": []
          }
        ],
        "responses": {
          "200": {
            "description": "Registration updated; Status=true, Error is empty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or ineligible authenticated session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 8192 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          },
          "422": {
            "description": "Invalid JSON or registration fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          },
          "503": {
            "description": "Device registry or user directory unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          }
        },
        "description": "Requires an active session with status=true, onetimepwd=false and a positive signed-64-bit iduser. The operation affects the authenticated user's device token. Maximum body size: 8192 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRegistration"
              }
            }
          },
          "x-max-bytes": 8192
        }
      },
      "delete": {
        "operationId": "push_api_delete_v1_pushadmin_devices",
        "summary": "Unregister a push device",
        "tags": [
          "API"
        ],
        "security": [
          {
            "Token": []
          }
        ],
        "responses": {
          "200": {
            "description": "Registration updated; Status=true, Error is empty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or ineligible authenticated session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 8192 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          },
          "422": {
            "description": "Invalid JSON or registration fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          },
          "503": {
            "description": "Device registry or user directory unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResult"
                }
              }
            }
          }
        },
        "description": "Requires an active session with status=true, onetimepwd=false and a positive signed-64-bit iduser. The operation affects the authenticated user's device token. Maximum body size: 8192 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceUnregistration"
              }
            }
          },
          "x-max-bytes": 8192
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ServiceInfo": {
        "type": "object",
        "properties": {
          "Status": {
            "type": "boolean"
          },
          "Error": {
            "type": "string"
          },
          "Engine_Type": {
            "type": "string"
          },
          "Engine_Uuid": {
            "type": "string"
          },
          "Engine_Version": {
            "type": "string"
          },
          "Engine_Lastheartbeat": {
            "type": "integer"
          },
          "Outboxes": {
            "type": "object",
            "properties": {
              "delivery": {
                "$ref": "#/components/schemas/OutboxStatus"
              },
              "results": {
                "$ref": "#/components/schemas/OutboxStatus"
              }
            },
            "required": [
              "delivery",
              "results"
            ],
            "additionalProperties": false,
            "description": "Present on every successful info response, including empty queues. A bounded read-only repeatable-read snapshot supplies aggregates only; unavailable evidence returns 503."
          }
        },
        "additionalProperties": true,
        "required": [
          "Status",
          "Error"
        ]
      },
      "DeviceRegistration": {
        "type": "object",
        "properties": {
          "device_token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4096,
            "pattern": "^[!-~]+$"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "device_token",
          "platform"
        ]
      },
      "DeviceUnregistration": {
        "type": "object",
        "properties": {
          "device_token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4096,
            "pattern": "^[!-~]+$"
          },
          "platform": {}
        },
        "additionalProperties": false,
        "required": [
          "device_token"
        ],
        "description": "Optional platform is accepted but ignored for DELETE."
      },
      "DeviceResult": {
        "type": "object",
        "properties": {
          "Status": {
            "type": "boolean"
          },
          "Error": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "Status",
          "Error"
        ]
      },
      "OutboxStatus": {
        "type": "object",
        "properties": {
          "Size": {
            "type": "integer",
            "minimum": 0,
            "description": "Delivery includes pending/sending jobs; results includes completed jobs awaiting reply publication, including uncertain outcomes."
          },
          "Latency_Seconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Age of the oldest queued item using PostgreSQL time; zero for an empty queue or a future timestamp."
          }
        },
        "required": [
          "Size",
          "Latency_Seconds"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Token": {
        "type": "apiKey",
        "in": "header",
        "name": "Token",
        "description": "Exactly one Token header, 1-4096 visible ASCII characters. Validated against the service's configured authorization backend."
      }
    }
  }
}
