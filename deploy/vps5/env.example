# Private runtime file, e.g. /opt/tronicare-admin/private/admin.env (mode 0600).
# Keep actual configuration in ignored .local/ while preparing a release.
# Use the exact public HTTPS origin, with no trailing slash or path.
PUBLIC_ORIGIN=https://admin.tronicare.com
# Generate on the target: openssl rand -base64 32
SESSION_SECRET=
API_ORIGIN=https://dev.api.tronicare.com
ENABLED_WRITE_SERVICES=users,organizations,assets,core,rules,actions
LEGACY_PASSWORD_SALT=tcare
# Restrictive caregiver role; verify it matches the deployed Users service.
CAREGIVER_USER_TYPE_IDS=27
# Optional per-service origins use origin-only HTTP(S) URLs, without credentials.
# USERS_API_ORIGIN=https://dev.api.tronicare.com
# CARE_API_ORIGIN is set by the optional compose.care.yaml overlay.
