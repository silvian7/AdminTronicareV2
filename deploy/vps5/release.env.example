# Release selection is separate from the private Admin runtime file.
# Use a full immutable image ID for a docker-load release, or a registry digest.
# ADMIN_IMAGE=registry.example.com/tronicare/admin@sha256:<64-hex-digest>
ADMIN_IMAGE=sha256:<64-hex-image-id>
ADMIN_ENV_FILE=/opt/tronicare-admin/private/admin.env
# Optional for archive-loaded dependencies whose registry digest mapping is absent.
# Defaults in Compose remain registry digest references. Verify loaded image IDs.
# SESSIONS_IMAGE=sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf
# CARE_POSTGRES_IMAGE=sha256:1c59e2c3c818eaa0f0628f695b36e7c9e362d6b219b36a54a32df645cbd7e1af
