{
  "name": "admin-tronicare-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/concurrently/dist/bin/concurrently.js -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && vite build && esbuild server/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src server shared/resources.ts tests *.ts package.json",
    "test:watch": "vitest",
    "contracts": "python scripts/sync-contracts.py",
    "contracts:check": "python scripts/sync-contracts.py --check"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/core": "^5.0.5",
    "@refinedev/react-router": "^2.0.0",
    "@tanstack/react-query": "5.103.0",
    "antd": "^5.29.3",
    "cookie": "^1.0.2",
    "dayjs": "^1.11.13",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "lossless-json": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.0",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.9",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0",
    "shell-quote": "^1.11.0"
  }
}
